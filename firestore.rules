rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 管理者：meta/owner に登録された1人だけ
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/meta/owner)
        && get(/databases/$(database)/documents/meta/owner).data.uid == request.auth.uid;
    }

    // 管理者の登録：まだ誰も登録していないときだけ、自分を登録できる（あとから変えるのは Firebase の管理画面で）
    match /meta/owner {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // アカウントの記録（名前・メール・最後に使った日時・端末・デッキの数）
    // ・書く：本人だけ　・読む：本人と管理者
    match /profiles/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'device', 'lastSeen', 'lastLogin', 'createdAt', 'provider', 'deckCount', 'version']);
    }

    // デッキ：ログインした本人だけが、自分のデッキ（users/<自分のID>）を読み書きできる
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['decks', 'currentDeck', 'updatedAt'])
        && request.resource.data.decks is list
        && request.resource.data.decks.size() <= 500;
    }

    // 対戦の部屋（部屋コード = ドキュメントID）
    // ・読む：ログインしていれば可（部屋コードを知っている人だけが参加できる）
    // ・作る：部屋を作る本人が host
    // ・変える：host か guest。まだ guest がいない部屋には、自分を guest にする変更だけ可
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.host == request.auth.uid ||
        resource.data.guest == request.auth.uid ||
        (resource.data.guest == null && request.resource.data.guest == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest', 'guestName'])));

      // 各プレイヤーの盤面（相手に見せてよい情報だけ）：本人だけが書ける
      match /players/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      // チャット・コイン・ダメージなどの出来事：書いた本人の名前でだけ追加できる
      match /events/{id} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      }
    }
  }
}
